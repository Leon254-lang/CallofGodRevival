NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=cgrm_website
ADMIN_SETUP_KEY=replace-with-a-random-secret-at-least-32-characters

# Configure SMTP to keep the contact and prayer forms working on Node hosting.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Call of God Revival Ministry International <website@example.org>
