NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=cgrm_website
ADMIN_SETUP_KEY=replace-with-a-random-secret-at-least-32-characters
PUBLIC_BASE_URL=https://your-church-domain.example

# OpenAI API key for the Bible and church website assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# LiveKit Cloud: create a project and keep its API secret server-side.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Egress writes MP4 recordings to S3-compatible object storage.
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=
RECORDING_S3_ENDPOINT=
RECORDING_S3_FORCE_PATH_STYLE=false

# Separate random secret used to sign opt-in subscriber unsubscribe links.
LIVE_NOTIFICATION_SECRET=replace-with-another-random-secret-at-least-32-characters

# Configure SMTP to keep the contact and prayer forms working on Node hosting.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Call of God Revival Ministry International <website@example.org>
